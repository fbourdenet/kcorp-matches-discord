# Paramètres du salon Discord → Intégrations → Webhooks → Copier l'URL
DISCORD_WEBHOOK_URL=

# Nom du projet + ton contact (URL ou email), exigé par les conditions de Liquipedia
# Exemple : KcorpMatchesDiscord/1.0 (contact@example.com)
LIQUIPEDIA_USER_AGENT=

# Optionnel : début de la fenêtre de 24 h, passée ou future (une date seule vaut minuit UTC)
# TARGET_DATE=2026-09-24T08:00:00+02:00

# Optionnel : imprime le payload sans poster
# DRY_RUN=1
